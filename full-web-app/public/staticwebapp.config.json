{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/assets/*",
      "/*.{css,js,map,png,jpg,jpeg,gif,svg,ico,webp,avif,woff,woff2,ttf,json}"
    ]
  },
  "globalHeaders": {
    "x-content-type-options": "nosniff",
    "referrer-policy": "strict-origin-when-cross-origin",
    "x-frame-options": "DENY"
  }
}
